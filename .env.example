# Copie ce fichier en .env.local pour le développement. .env.local est ignoré par Git.
# En ligne, ces valeurs se mettent dans Vercel > Settings > Environment Variables.

# Obligatoire : sans mot de passe, personne ne peut se connecter.
ACCESS_PASSWORD=

# Stockage kDrive. Sans ces trois valeurs, l'app stocke dans data/ sur le disque.
# Jeton : https://manager.infomaniak.com/v3/ng/accounts/token/list, portée "drive".
KDRIVE_TOKEN=
KDRIVE_DRIVE_ID=
KDRIVE_FOLDER_ID=
