{
	"name": "intermittens",
	"private": true,
	"version": "0.0.11",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/vercel-include-dynamic.mjs",
		"start": "node build",
		"setup": "node scripts/setup-deploy.mjs",
		"setup:deploy": "node scripts/setup-deploy.mjs",
		"upload": "node scripts/deploy.mjs",
		"predeploy": "npm version patch --no-git-tag-version",
		"deploy": "node scripts/deploy.mjs && node scripts/remote-runtime.mjs install && node scripts/remote-runtime.mjs restart",
		"deploy:dry-run": "node scripts/deploy.mjs --dry-run",
		"deploy:stage": "node scripts/deploy.mjs --stage-only",
		"remote:start": "node scripts/remote-runtime.mjs start",
		"remote:install": "node scripts/remote-runtime.mjs install",
		"remote:restart": "node scripts/remote-runtime.mjs restart",
		"remote:stop": "node scripts/remote-runtime.mjs stop",
		"remote:status": "node scripts/remote-runtime.mjs status",
		"publish": "npm run deploy",
		"preview": "vite preview",
		"test": "node scripts/test-document-analysis.mjs && node scripts/test-stats.mjs && node scripts/test-document-presence.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:kdrive": "node scripts/test-kdrive.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.6",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"ssh2-sftp-client": "^12.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.8",
		"@tesseract.js-data/fra": "^1.0.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.3.289",
		"tesseract.js": "^7.0.0"
	}
}
